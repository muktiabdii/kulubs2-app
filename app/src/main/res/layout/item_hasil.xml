<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="20dp"
        app:cardCornerRadius="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Gambar -->
            <ImageView
                android:id="@+id/img_warung"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:contentDescription="Gambar Warung"
                android:scaleType="centerCrop"
                android:src="@drawable/sample_warung" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/img_warung"
                android:orientation="horizontal">

                <!-- Bagian Informasi -->
                <LinearLayout
                    android:id="@+id/layout_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:paddingLeft="12dp">

                    <!-- Nama Warung -->
                    <TextView
                        android:id="@+id/tv_nama_warung"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lalapan Mbak L"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Rating & Disukai -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Bintang Rating -->
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_star"
                            app:tint="#FF5F00" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_star" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_star" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_star" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_star" />

                        <!-- Rating angka -->
                        <TextView
                            android:id="@+id/tv_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="4dp"
                            android:text=" 4.9"
                            android:textColor="@color/black"
                            android:textSize="14sp" />

                        <!-- Jumlah Disukai -->
                        <TextView
                            android:id="@+id/tv_likes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:background="@drawable/bg_rounded_stroke"
                            android:fontFamily="@font/raleway_regular"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="Disukai 200"
                            android:textColor="@color/black"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Deskripsi -->
                    <TextView
                        android:id="@+id/tv_deskripsi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/raleway_regular"
                        android:text="Kantin FILKOM di belakang GKM"
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                    <!-- Kategori -->
                    <TextView
                        android:id="@+id/tv_kategori"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Mie, Nusantara, Nasi"
                        android:textColor="#EAA23F"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Tombol WhatsApp & Tulis Review -->
                <LinearLayout
                    android:id="@+id/layout_buttons"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingEnd="5dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_whatsapp"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_gravity="end"
                        android:layout_marginBottom="4dp"
                        android:backgroundTint="#F5F5F5"
                        android:drawableLeft="@drawable/ic_wa"
                        android:fontFamily="@font/raleway_medium"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="Whatsapp"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        app:cornerRadius="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_review"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:backgroundTint="#CC4302"
                        android:drawableLeft="@drawable/ic_pencil"
                        android:fontFamily="@font/raleway_medium"
                        android:paddingLeft="15dp"
                        android:paddingRight="15dp"
                        android:text="Tulis Review"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        app:cornerRadius="10dp" />

                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>