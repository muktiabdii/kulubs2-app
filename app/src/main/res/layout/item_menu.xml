<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Gambar Menu -->
        <ImageView
            android:id="@+id/ivMenuImage"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            android:background="@drawable/rounded_corner_8dp"
            android:src="@drawable/placeholder_food"
            android:contentDescription="Gambar Menu"/>

        <!-- Informasi Menu -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNamaMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ayam Bakar"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/raleway_bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvDeskripsiMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Ayam bakar dengan bumbu khas"
                android:textColor="@color/gray"
                android:textSize="12sp"
                android:fontFamily="@font/raleway_medium"
                android:maxLines="2"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvHargaMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Rp 15.000"
                android:textColor="@color/orange"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/raleway_bold"/>
        </LinearLayout>

        <!-- Tombol Action -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Tombol Edit -->
            <ImageButton
                android:id="@+id/btnEditMenu"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/circle_blue_background"
                android:scaleType="centerInside"
                android:src="@drawable/ic_edit"
                android:padding="8dp"
                android:contentDescription="Edit Menu"/>

            <!-- Tombol Delete -->
            <ImageButton
                android:id="@+id/btnDeleteMenu"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_red_background"
                android:scaleType="centerInside"
                android:src="@drawable/ic_delete"
                android:padding="8dp"
                android:contentDescription="Hapus Menu"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>